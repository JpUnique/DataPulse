# Values below are for running Django/Celery on your machine (outside Docker).
# Ports are the host ports published in docker-compose.yml.

# Django
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=datapulse
POSTGRES_USER=datapulse
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5436

# Redis / Celery
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=datapulse
CLICKHOUSE_PASSWORD=replace-with-a-local-password
CLICKHOUSE_DATABASE=datapulse

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
